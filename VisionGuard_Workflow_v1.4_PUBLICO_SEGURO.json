      "id": "c8286e32-5e99-469e-96a4-99696f8f102e",
      "name": "Send a message1"
    },
    {
      "parameters": {
        "jsCode": "\nconst entradas = $input.all();\nconst inferencias = $('HTTP Request').all().map(item => item.json);\n\nreturn entradas.map((item, index) => {\n  const contenido = item.json.output?.[0]?.content?.[0];\n\n  if (!contenido || contenido.text == null) {\n    throw new Error('No se encontro el resultado de GPT.');\n  }\n\n  const resultado = typeof contenido.text === 'string'\n    ? JSON.parse(contenido.text)\n    : contenido.text;\n\n  if (!resultado || typeof resultado !== 'object') {\n    throw new Error('Formato de respuesta de GPT invalido.');\n  }\n\n  const api = inferencias.find(\n    dato => dato.archivo === resultado.archivo\n  );\n\n  if (!api) {\n    throw new Error('No se encontro la inferencia original.');\n  }\n\n  const clasificacion = String(api.clasificacion)\n    .trim()\n    .toLowerCase();\n\n  if (!['correcta', 'defectuosa'].includes(clasificacion)) {\n    throw new Error('Clasificacion desconocida.');\n  }\n\n  const esDefectuosa = clasificacion === 'defectuosa';\n\n  // Ante un valor desconocido, exigir revision.\n  const revisionAPI = !(\n    api.requiere_revision_humana === false ||\n    api.requiere_revision_humana === 'false'\n  );\n\n  const requiereRevision = esDefectuosa || revisionAPI;\n\n  // ResNet18 conserva la autoridad sobre la prediccion.\n  resultado.archivo = api.archivo;\n  resultado.clasificacion = api.clasificacion;\n  resultado.confianza = Number(api.confianza);\n\n  if (!Number.isFinite(resultado.confianza)) {\n    throw new Error('Confianza del modelo invalida.');\n  }\n\n  // Regla determinista de seguridad industrial.\n  resultado.requiere_revision_humana = requiereRevision;\n\n  if (requiereRevision) {\n    resultado.prioridad = 'alta';\n  }\n\n  if (esDefectuosa) {\n    resultado.recomendacion =\n      'Apartar la pieza para inspeccion humana. No aprobar automaticamente.';\n\n    resultado.justificacion =\n      `${resultado.justificacion || ''} ` +\n      'El protocolo exige revision humana para toda pieza defectuosa.';\n  }\n\n  // Mantener la estructura que utiliza Google Sheets.\n  contenido.text = resultado;\n\n  return {\n    ...item,\n    pairedItem: { item: index }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
