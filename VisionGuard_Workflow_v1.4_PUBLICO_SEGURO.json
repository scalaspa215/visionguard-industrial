        "message": "={{ (() => {\n  const d = Object.fromEntries(\n    Object.entries($json).map(([k, v]) => [k.trim(), v])\n  );\n\n  return `\n    <h2>⚠️ ALERTA DE CALIDAD - VISIONGUARD</h2>\n    <p><b>Archivo:</b> ${d.archivo}</p>\n    <p><b>Clasificación:</b> ${d.clasificacion}</p>\n    <p><b>Confianza:</b> ${(Number(d.confianza) * 100).toFixed(2)}%</p>\n    <p><b>Prioridad:</b> ${d.prioridad}</p>\n    <h3>Diagnóstico</h3>\n    <p>${d.diagnostico}</p>\n    <h3>Recomendación</h3>\n    <p>${d.recomendacion}</p>\n    <h3>Justificación</h3>\n    <p>${d.justificacion}</p>\n    <p><b>Requiere revisión humana:</b>\n    ${String(d.requiere_revision_humana).toLowerCase() === 'true' ? 'Sí' : 'No'}</p>\n    <hr>\n    <p><i>Resultado automatizado. Confirmar mediante el protocolo de inspección humana.</i></p>\n  `;\n})() }}",
